[Unit]
Description=Dyna service relay of room room_1
StartLimitIntervalSec=600
StartLimitBurst=5

[Container]
ContainerName=dyna-svc-svc_1
Image=ghcr.io/o/r@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
Pull=missing
Label=dyna.service=svc_1
UserNS=nomap
Network=pasta:--no-map-gw
DropCapability=all
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=false
PodmanArgs=--image-volume=ignore
Tmpfs=/tmp:rw,size=64m,mode=1777
PodmanArgs=--cpus=1.5 --memory=536870912 --memory-swap=536870912 --pids-limit=768
PublishPort=443:443/tcp
PublishPort=8443:9000/udp
Volume=dyna-svc-svc_1:/var/lib/relay
Environment="MODE=prod"
Environment="PCT=100%%$$HOME"
Secret=dyna-svc-svc_1-TOKEN,type=env,target=TOKEN
Exec="/relay" "--serve"

[Service]
Slice=dyna-svc.slice
Restart=always

[Install]
WantedBy=default.target
