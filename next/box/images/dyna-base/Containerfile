FROM node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates coreutils curl findutils git grep openssh-client procps sed tini \
    && rm -rf /var/lib/apt/lists/*
COPY pi.tgz /tmp/pi.tgz
RUN npm install --global --ignore-scripts /tmp/pi.tgz && rm /tmp/pi.tgz \
    && mkdir -p /box/home /box/pi && chown node:node /box/home /box/pi
ENV HOME=/box/home PI_CODING_AGENT_DIR=/box/pi PATH=/opt/dyna/bin/current:${PATH}
USER node
WORKDIR /box/home
ENTRYPOINT ["/usr/bin/tini", "--"]
