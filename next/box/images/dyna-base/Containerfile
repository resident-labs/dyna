FROM node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates chromium coreutils curl findutils fonts-liberation fonts-noto-color-emoji git grep jwm openssh-client procps sed \
    tigervnc-standalone-server tini unzip xdotool \
    && rm -rf /var/lib/apt/lists/*
RUN case "$(dpkg --print-architecture)" in \
    amd64) arch=x86_64 sha=45f1447fbe231e3037bde351ef70677dd212216c8d62ae7ca409fecc4d6acc89 ;; \
    arm64) arch=aarch64 sha=2b3284d5da3b46a47dc4229e75bb7b88ac4aa99c8d754fb7d2f84997e5a4354a ;; \
    *) exit 1 ;; esac \
    && name="sccache-v0.18.0-${arch}-unknown-linux-musl" \
    && curl -fsSL -o /tmp/sccache.tgz "https://github.com/mozilla/sccache/releases/download/v0.18.0/${name}.tar.gz" \
    && echo "${sha}  /tmp/sccache.tgz" | sha256sum -c - \
    && tar -xzf /tmp/sccache.tgz -C /usr/local/bin --strip-components=1 --no-same-owner "${name}/sccache" \
    && rm /tmp/sccache.tgz
# Chromium's extensions, unpacked from their GitHub releases, load at every launch (5.14). The node user owns them because Chromium writes each unpacked extension's indexed rulesets into its _metadata folder and refuses an extension with rules when it cannot ("Internal error while parsing rules"). Debian's /etc/chromium.d/extensions would add an empty --load-extension=, so it keeps only its --enable-remote-extensions line. uBlock Origin Lite keeps its filter
# lists as rulesets named in its manifest and ruleset details, so the cookie-notice, overlay and other annoyance lists, off in the release, are turned on there.
RUN mkdir -p /opt/dyna/extensions/ubol /opt/dyna/extensions/isdcac \
    && curl -fsSL -o /tmp/ubol.zip https://github.com/uBlockOrigin/uBOL-home/releases/download/2026.1026.1812/uBOLite_2026.1026.1812.chromium.zip \
    && echo "d3788eac9f0a44c67f3745a43c3fd446ef33d56b1121f469b19e0fa0a836c2b5  /tmp/ubol.zip" | sha256sum -c - \
    && unzip -q /tmp/ubol.zip -d /opt/dyna/extensions/ubol \
    && node -e 'const fs=require("fs");for(const p of ["manifest.json","rulesets/ruleset-details.json"]){const f="/opt/dyna/extensions/ubol/"+p,m=JSON.parse(fs.readFileSync(f));let n=0;for(const r of p==="manifest.json"?m.declarative_net_request.rule_resources:m)if(["annoyances-cookies","annoyances-overlays","annoyances-others"].includes(r.id)){r.enabled=true;n++}if(n!==3)throw new Error(p+": "+n+" annoyance rulesets");fs.writeFileSync(f,JSON.stringify(m))}' \
    && curl -fsSL -o /tmp/isdcac.zip https://github.com/OhMyGuus/I-Still-Dont-Care-About-Cookies/releases/download/v1.1.9/ISDCAC-chrome-source.zip \
    && echo "8f70ab947cb2d274f4022a970f5dd3cecd8ec02b060e05187bef9ee3cb18bbcb  /tmp/isdcac.zip" | sha256sum -c - \
    && unzip -q /tmp/isdcac.zip -d /opt/dyna/extensions/isdcac \
    && rm /tmp/ubol.zip /tmp/isdcac.zip \
    && chown -R node:node /opt/dyna/extensions \
    && echo 'export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --enable-remote-extensions"' > /etc/chromium.d/extensions
COPY pi.tgz /tmp/pi.tgz
RUN npm install --global --ignore-scripts /tmp/pi.tgz && rm /tmp/pi.tgz \
    && mkdir -p /box/home /box/pi /box/work && chown node:node /box /box/home /box/pi /box/work
# Cargo compiles through sccache, which keeps its results in the host's compiler cache behind the box agent. It skips its
# check of that cache, which would fail every build while the cache is down, and a crate it cannot read or write it compiles.
# The endpoint ends without a slash because sccache adds one, and the box agent redirects a path with two, which a write does
# not follow.
ENV HOME=/box/home PI_CODING_AGENT_DIR=/box/pi PATH=/opt/dyna/bin/current:${PATH} \
    RUSTC_WRAPPER=sccache SCCACHE_WEBDAV_ENDPOINT=http://127.0.0.1:7781/build-cache SCCACHE_SKIP_CACHE_CHECK=1
USER node
WORKDIR /box/home
ENTRYPOINT ["/usr/bin/tini", "--"]
