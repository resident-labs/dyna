{
  "name": "dyna-desktop-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:ci": "node --test ${FRONTEND_SHARD:+--test-shard=$FRONTEND_SHARD} --test-reporter=spec --test-reporter=junit --test-reporter=./scripts/test-files-reporter.ts --test-reporter-destination=stdout --test-reporter-destination=\"$JUNIT_REPORT_PATH\" --test-reporter-destination=\"${TEST_FILES_PATH:-/dev/null}\" \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "check": "node scripts/check-typescript.ts && svelte-check --tsconfig ./tsconfig.json && tsc --project ./tsconfig.json && tsc --project ./tsconfig.worker.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@novnc/novnc": "^1.7.0",
    "@tanstack/virtual-core": "^3.19.6",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode-generator": "^2.0.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
