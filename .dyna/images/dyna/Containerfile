FROM dyna-base
RUN apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates curl && rm -rf /var/lib/apt/lists/*
RUN arch="$(dpkg --print-architecture)" && case "$arch" in \
    amd64) sha=ccfe7ae822d2c2f41f4fe7c956199967a4dac22d0ee0d2b2bfdb440aab3b20c5 ;; \
    arm64) sha=3f4227ce7b206a513e794f1393adb473a07b46e94d18bd15d1c684bbb7319797 ;; \
    *) exit 1 ;; esac && \
    curl -fsSL "https://go.dev/dl/go1.26.10.linux-${arch}.tar.gz" -o /tmp/go.tar.gz && \
    echo "$sha  /tmp/go.tar.gz" | sha256sum -c - && \
    tar -C /usr/local -xzf /tmp/go.tar.gz && rm /tmp/go.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}" GOMODCACHE=/box/cache/gomod GOCACHE=/box/cache/gobuild npm_config_cache=/box/cache/npm npm_config_store_dir=/box/cache/pnpm
